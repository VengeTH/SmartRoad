# Supabase Configuration
# 
# OPTION 1: Supabase Cloud (Free Tier Available)
# Get these values from your Supabase project dashboard
# https://app.supabase.com/project/YOUR_PROJECT/settings/api
#
# OPTION 2: Self-Hosted Supabase
# Point to your self-hosted Supabase instance
# Example: http://your-server.com:8000 or https://supabase.yourdomain.com
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
#
# For self-hosted, use:
# SUPABASE_URL=http://your-server-ip:8000
# SUPABASE_ANON_KEY=your-self-hosted-anon-key
SUPABASE_URL=
SUPABASE_ANON_KEY=

